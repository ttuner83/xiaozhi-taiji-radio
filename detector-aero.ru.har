n    </div>\n\n    <div id=\"boot-splash\" role=\"status\" aria-label=\"Загрузка карты\">\n      <div class=\"bs-brand\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19.07 4.93A10 10 0 0 0 6.99 3.34\"/><path d=\"M4 6h.01\"/><path d=\"M2.29 9.62A10 10 0 1 0 21.31 8.35\"/><path d=\"M16.24 7.76A6 6 0 1 0 8.23 16.67\"/><path d=\"M12 18h.01\"/><path d=\"M17.99 11.66A6 6 0 0 1 15.77 16.67\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"m13.41 10.59 5.66-5.66\"/></svg>\n        <strong>Детектор АЭРО</strong>\n        <span>карта воздушной обстановки</span>\n      </div>\n      <div class=\"bs-bar\" aria-hidden=\"true\"><i></i></div>\n      <div class=\"bs-note\" id=\"boot-splash-note\" aria-live=\"polite\">Загрузка…</div>\n    </div>\n    <script>\n\n      (function () {\n        try {\n          var splash = document.getElementById(\"boot-splash\");\n          var note = document.getElementById(\"boot-splash-note\");\n          if (!splash || !note) return;\n          var msgs = [\n            \"Устанавливаем защищённое соединение…\",\n            \"Обновляем источники…\",\n            \"Загружаем карту…\",\n            \"Отрисовываем воздушную обстановку…\",\n            \"Почти готово…\"\n          ];\n          var i = 0;\n          note.textContent = msgs[0];\n          var tick = setInterval(function () {\n            if (i < msgs.length - 1) { i++; note.textContent = msgs[i]; }\n          }, 2600);\n          var done = false;\n          var fuse = null;\n          function hide() {\n            if (done) return;\n            done = true;\n            clearInterval(tick);\n            if (fuse !== null) { clearTimeout(fuse); fuse = null; }\n            splash.classList.add(\"bs-hide\");\n            setTimeout(function () { if (splash) splash.style.display = \"none\"; }, 500);\n          }\n\n          var sky = window.__skyLoad;\n   