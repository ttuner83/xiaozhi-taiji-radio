            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"ru\">\n  <head>\n  <meta name=\"sky-build-version\" content=\"6937493771ccf369ff32\">\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n\n    <meta name=\"theme-color\" content=\"#dfe7e4\" />\n    <meta\n      name=\"description\"\n      content=\"Детектор АЭРО — радар БПЛА и карта воздушной обстановки онлайн: активные зоны, воздушные тревоги и работа ПВО в реальном времени, карта укрытий, сообщения очевидцев.\"\n    />\n    <meta name=\"robots\" content=\"index,follow\" />\n    <link rel=\"canonical\" href=\"https://detector-aero.ru/\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://detector-aero.ru/\" />\n    <meta property=\"og:site_name\" content=\"Детектор АЭРО\" />\n    <meta property=\"og:locale\" content=\"ru_RU\" />\n    <meta property=\"og:title\" content=\"Карта БПЛА онлайн — радар БПЛА и воздушная обстановка | Детектор АЭРО\" />\n    <meta\n      property=\"og:description\"\n      content=\"Радар БПЛА и публичная карта воздушной обстановки: активные зоны, воздушные тревоги, работа ПВО, карта укрытий и сообщения очевидцев. Без раскрытия источников и расчётных данных.\"\n    />\n    <meta property=\"og:image\" content=\"https://detector-aero.ru/og-cover.png\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:alt\" content=\"Детектор АЭРО — карта воздушной обстановки\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Карта БПЛА онлайн — радар БПЛА и воздушная обстановка | Детектор АЭРО\" />\n    <meta\n      name=\"twitter:description\"\n      content=\"Радар БПЛА и публичная карта воздушной обстановки: активные зоны, воздушные тревоги, работа ПВО, карта укрытий и сообщения очевидцев.\"\n    />\n    <